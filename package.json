{
  "name": "coworker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "start": "pnpm --filter @coworker/cli start",
    "db:generate": "pnpm --filter @coworker/core db:generate",
    "db:migrate": "pnpm --filter @coworker/core db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
