{
  "name": "@coworker/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "coworker": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@coworker/adapters": "workspace:*",
    "@coworker/daemon": "workspace:*",
    "@coworker/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.2",
    "smol-toml": "^1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
